# ==============================================================
# secure-crm — variables de entorno de ejemplo
# Copia este archivo a .env  (cp .env.example .env)
# ==============================================================

# ---- API (apps/api) ----
API_PORT=4000
# Secreto para firmar los JWT: mínimo 32 caracteres aleatorios, nunca uno fijo
# en el repositorio. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Si se deja vacío, la API genera uno aleatorio en cada arranque.
JWT_SECRET=
# Orígenes permitidos por CORS (separados por coma)
CORS_ORIGINS=http://localhost:3000

# ---- WEB (apps/web) ----
# URL de la API que consume el frontend (navegador -> API).
# Para pasar por el WAF (Hito 3): http://localhost:8080
NEXT_PUBLIC_API_URL=http://localhost:4000

# Las variables del WAF (WAF_PORT, WAF_BIND, MODSEC_RULE_ENGINE...) van en waf-siem/.env
